<div class="brand-row">
    <a class="brand" href="" aria-label="My Dev Tools home">
        <span class="brand-mark"><span class="bi bi-braces" aria-hidden="true"></span></span>
        <span><strong>My Dev Tools</strong><small>Developer toolbox</small></span>
    </a>
    <button title="Toggle navigation" aria-label="Toggle navigation" class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="bi bi-list" aria-hidden="true"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav aria-label="Main navigation">
        <span class="nav-label">Workspace</span>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span class="bi bi-grid-1x2-fill"></span> Overview</NavLink>
        </div>

        <span class="nav-label tools-label">Tools</span>
        @foreach (var item in Tools)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="@item.Path" aria-label="@($"Navigate to {item.Label}")">
                    <span class="bi @item.Icon" aria-hidden="true"></span> @item.Label
                </NavLink>
            </div>
        }

        <div class="nav-footer">
            <div class="privacy-note">
                <span class="bi bi-shield-check" aria-hidden="true"></span>
                <span><strong>Your data stays yours</strong><small>Everything runs on this device.</small></span>
            </div>
            <a class="nav-link external-link" href="https://mydevtools.org" target="_blank" rel="noopener noreferrer">
                <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span> Vue version
            </a>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private static readonly (string Path, string Label, string Icon)[] Tools =
    [
        ("JsonFormatter", "JSON Formatter", "bi-code-square"),
        ("DiffChecker", "Diff Checker", "bi-file-diff"),
        ("SqlFormatter", "SQL Formatter", "bi-table"),
        ("GuidGenerator", "GUID Generator", "bi-key"),
        ("randomNumberGenerator", "Random Numbers", "bi-dice-3"),
        ("ColorPickerConverter", "Colour Converter", "bi-palette"),
        ("hashGenerator", "Hash Generator", "bi-fingerprint"),
        ("UrlEncoderDecoder", "URL Encoder", "bi-link-45deg"),
        ("QrCodeGen", "QR Generator", "bi-qr-code"),
        ("BranchNameFormatter", "Branch Names", "bi-git"),
        ("CronGenerator", "Cron Generator", "bi-clock"),
        ("JwtDecoder", "JWT Decoder", "bi-shield-lock"),
        ("containerIds", "Container IDs", "bi-box-seam")
    ];

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
