@inherits LayoutComponentBase

<div class="page-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-panel">
        <header class="app-header">
            <div>
                <span class="eyebrow">Developer utilities</span>
                <strong>Private by design</strong>
